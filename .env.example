# Postgres — Neon (postgres://...?sslmode=require), Supabase, or local.
# Local dev with docker:
#   docker run -d --name softgen-pg -e POSTGRES_PASSWORD=softgen -p 5432:5432 postgres:16
#   DATABASE_URL=postgres://postgres:softgen@localhost:5432/postgres?sslmode=disable
DATABASE_URL=

# next-auth — generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3005

# Resend — leave blank to use the console.log fallback (lib/email.ts).
RESEND_API_KEY=
LEAD_NOTIFY_TO=sales@softgen.ge
APPLICATION_NOTIFY_TO=careers@softgen.ge
EMAIL_FROM=Softgen <hello@softgen.ge>

# Vercel Blob — leave blank to use the local-disk fallback (lib/blob.ts).
BLOB_READ_WRITE_TOKEN=

# Seed credentials (admin user created by db/seed.ts on first run).
SEED_ADMIN_EMAIL=levan@softgen.ge
SEED_ADMIN_PASSWORD=changeme-now
