# ─── softgen.ge — production environment template ─────────────────────────────
#
# Copy to `.env.production` (or pass via your secrets manager / Docker secrets)
# on the deployment host. NEVER commit a populated copy.
#
# Required vars are marked. Optional vars have working fallbacks documented
# in the file they're consumed from.

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Inside docker-compose.prod.yml the app talks to Postgres via the internal
# hostname `postgres` over the docker network — port 5432 there, NOT 5440.
# 5440 is the host-side port for connecting from your laptop.
DATABASE_URL=postgres://softgen:CHANGE_ME@postgres:5432/softgen?sslmode=disable

# ── next-auth (REQUIRED) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# Rotate per environment. Changing this signs out every active admin session.
NEXTAUTH_SECRET=

# Public URL the browser hits — used by next-auth for callbacks + redirects,
# by sitemap.xml, by canonical/OG metadata, and by admin notification emails.
# Examples:
#   https://softgen.ge
#   https://staging.softgen.ge
NEXTAUTH_URL=https://softgen.ge
NEXT_PUBLIC_SITE_URL=https://softgen.ge

# ── Email — Resend (OPTIONAL) ─────────────────────────────────────────────────
# Without RESEND_API_KEY, lead/application notifications are logged to the
# container's stdout (lib/email.ts fallback). Add the key to actually send.
# Free tier: 100/day, 3000/month. https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Softgen <hello@softgen.ge>

# Notify-to addresses can be edited at runtime in /admin/settings — these
# env vars are only the first-boot fallback before settings are populated.
LEAD_NOTIFY_TO=sales@softgen.ge
APPLICATION_NOTIFY_TO=careers@softgen.ge

# ── File uploads — Vercel Blob (OPTIONAL) ─────────────────────────────────────
# Without BLOB_READ_WRITE_TOKEN, CV + image uploads write to /app/public/uploads
# inside the container (lib/blob.ts fallback). docker-compose.prod.yml mounts a
# named volume there so uploads survive container restarts. For multi-instance
# deploys (load balancer + ≥2 app containers), Vercel Blob or S3 is required —
# the disk fallback can't be shared across instances.
BLOB_READ_WRITE_TOKEN=

# ── Seed admin (FIRST-RUN ONLY) ───────────────────────────────────────────────
# Used once by `pnpm db:seed`. After first sign-in, change the password from
# the admin and remove this from the env. Re-running the seed will not reset
# an existing admin's password.
SEED_ADMIN_EMAIL=levan@softgen.ge
SEED_ADMIN_PASSWORD=CHANGE_ME_FIRST_RUN

# ── Docker compose vars (used by docker-compose.prod.yml) ─────────────────────
POSTGRES_USER=softgen
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=softgen
APP_PORT=3005
