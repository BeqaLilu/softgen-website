# Source-control + IDE
.git
.gitignore
.vscode
.idea

# Local-only artifacts
node_modules
.next
.turbo
.swc
.cache

# Environment files — image MUST use env vars passed at runtime, never baked.
# Catch every variant (.env, .env.local, .env.production, .env.staging, …).
.env
.env.*

# Dev tooling
docker-compose.dev.yml
*.log

# Handoff package — only useful at design time, never needs to ship
handoff
public/uploads
